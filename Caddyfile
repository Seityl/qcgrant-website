{
	# Global options
	admin off
	log {
		output file ./logs/caddy-access.log {
			roll_size 100mb
			roll_keep 10
		}
		format json
	}
}

# HTTP to HTTPS redirect
http://10.147.17.62 {
	redir https://10.147.17.62{uri} permanent
}

# HTTPS configuration
https://10.147.17.62 {
	# Use self-signed certificate for development
	tls internal
	
	# API reverse proxy - handle this first
	handle /api/* {
		reverse_proxy localhost:3001
	}

	# Handle everything else
	handle {
		# Set server root
		root * /var/www/qcgrant-website

		# Enable file server
		file_server

		# Enable gzip and Brotli compression
		encode gzip zstd
	}

	# Security Headers
	header {
		# Prevent clickjacking
		X-Frame-Options "DENY"
		
		# XSS Protection
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		
		# Referrer Policy
		Referrer-Policy "strict-origin-when-cross-origin"
		
		# Permissions Policy (formerly Feature-Policy)
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		
		# HSTS (HTTP Strict Transport Security) - Disabled for development
		# Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		
		# Content Security Policy
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; connect-src 'self' ws://10.147.17.62:1313 wss://10.147.17.62:1313 https://cdn.jsdelivr.net https://www.google-analytics.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
		
		# Remove server information
		-Server
	}

	# Cache static assets
	@static {
		path *.css *.js *.jpg *.jpeg *.png *.gif *.svg *.woff *.woff2 *.ttf *.eot *.ico *.webp *.avif
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cache HTML with validation
	@html {
		path *.html
	}
	header @html Cache-Control "public, max-age=3600, must-revalidate"

	# Logging
	log {
		output file ./logs/site-access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
	
	# Custom error page
	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}