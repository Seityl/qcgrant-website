{
	# Global options
	admin off
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 10
		}
		format json
	}
}

# Development configuration
:8080 {
	# API reverse proxy - handle this first
	handle /api/* {
		reverse_proxy localhost:3001
	}

	# Hugo livereload - proxy to Hugo dev server
	handle /livereload* {
		reverse_proxy localhost:1313 {
			header_up Host {host}
			header_up X-Real-IP {remote}
		}
	}

	# Handle everything else
	handle {
		# Set server root
		root * /home/hugo/qcgrant-website-build/public

		# Enable file server
		file_server

		# Enable gzip and Brotli compression
		encode gzip zstd

		# Handle SPA routing
		try_files {path} {path}.html {path}/ /404.html
	}

	# Security Headers
	header {
		# Prevent clickjacking
		X-Frame-Options "DENY"
		
		# XSS Protection
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		
		# Referrer Policy
		Referrer-Policy "strict-origin-when-cross-origin"
		
		# Permissions Policy (formerly Feature-Policy)
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		
		# HSTS (HTTP Strict Transport Security) - Disabled for development
		# Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		
		# Content Security Policy
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; connect-src 'self' ws://10.147.17.62:1313 https://www.google-analytics.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
		
		# Remove server information
		-Server
	}

	# Cache static assets
	@static {
		path *.css *.js *.jpg *.jpeg *.png *.gif *.svg *.woff *.woff2 *.ttf *.eot *.ico *.webp *.avif
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cache HTML with validation
	@html {
		path *.html
	}
	header @html Cache-Control "public, max-age=3600, must-revalidate"

	# Logging
	log {
		output file /var/log/caddy/site-access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}
