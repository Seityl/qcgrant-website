# Contact Form API Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:1313,http://10.147.17.62:1313,https://qcgrant.com,https://www.qcgrant.com

# Email Configuration (SMTP)
# For Gmail: Use App Password, not regular password
# Enable 2FA and create App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Alternative SMTP providers:
# SendGrid: smtp.sendgrid.net (Port 587)
# Mailgun: smtp.mailgun.org (Port 587)
# Amazon SES: email-smtp.us-east-1.amazonaws.com (Port 587)

# Email Addresses
SMTP_FROM=noreply@qcgrant.com
CONTACT_EMAIL=support@qcgrant.com

# Optional Features
SEND_AUTO_REPLY=false